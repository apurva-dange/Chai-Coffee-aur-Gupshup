function authorizeCalendar(){Calendar.Freebusy.query({timeMin:new Date().toISOString(),timeMax:new Date(Date.now()+60000).toISOString(),timeZone:TZ,items:[{id:CALENDAR_ID}]})}
function doGet(e){try{if(e.parameter.action!=="availability")throw Error("Unknown action");var cb=String(e.parameter.callback||"");if(!/^[A-Za-z_$][0-9A-Za-z_$]*$/.test(cb))throw Error("Invalid callback");var y=+e.parameter.year,m=+e.parameter.month,d=duration_(e.parameter.duration);if(!Number.isInteger(y)||y<2020||y>2100||!Number.isInteger(m)||m<0||m>11)throw Error("Invalid date");return javascript_(cb,{slots:availability_(y,m,d)})}catch(x){return javascript_(String(e.parameter.callback||"console.error"),{error:x.message||"The booking service is unavailable."})}}
